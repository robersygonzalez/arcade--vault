{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/format-and-lint.mjs"],
            "timeout": 30,
            "statusMessage": "Formatting with Prettier + ESLint..."
          }
        ]
      }
    ]
  }
}
